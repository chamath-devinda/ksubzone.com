{
  "name": "ksubzone",
  "version": "1.0.0",
  "description": "KDrama Streaming & Review Platform - Workspace structure",
  "scripts": {
    "install:client": "npm --prefix client install",
    "install:server": "npm --prefix server install",
    "install-all": "npm run install:client && npm run install:server",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "node server-php/run-server.js",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build:client": "npm --prefix client run build",
    "import:mongo": "node scripts/import-mongo-to-sqlite.js",
    "start:server": "node server-php/run-server.js",
    "test": "node --test tests/r2-features.test.mjs",
    "test:php": "php server-php/tests/test-r2-features.php",
    "test:all": "npm run test && npm run test:php && npm run test:admin",
    "migrate:subtitles": "php server-php/scripts/migrate-subtitles-to-r2.php",
    "migrate:subtitles:node": "node scripts/migrate-subtitles-to-r2.mjs",
    "package:backend": "powershell -ExecutionPolicy Bypass -File scripts/package-backend.ps1",
    "test:admin": "node --test tests/admin-core.test.mjs && php server-php/tests/test-admin-core.php"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "mongodb": "^7.2.0",
    "sqlite3": "^6.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "bcrypt": "^6.0.0",
    "pg": "^8.22.0"
  }
}
