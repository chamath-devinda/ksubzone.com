---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Detail } from '@/components/islands';
import { fetchBackendJson } from '@/lib/server/backend';
import {
  SITE_URL,
  cleanMediaTitle,
  cleanMediaText,
  clampDescription,
  buildMediaMetaTitle,
  buildMediaMetaDescription,
  generateMediaKeywords,
  buildDramaSchema,
  buildBreadcrumbSchema,
} from '@/lib/seo';

export const prerender = true;

export async function getStaticPaths() {
  try {
    const data = await fetchBackendJson('/api/media/dramas?status=Published&limit=300', {
      revalidate: 300,
      fallback: { dramas: [] },
    });
    const dramas = data?.dramas || [];
    return dramas
      .filter((d: any) => d.slug || d.title)
      .map((drama: any) => ({
        params: {
          slug: drama.slug || drama._id,
        },
      }));
  } catch (e) {
    console.error('[getStaticPaths:dramas] Failed to pre-fetch drama slugs:', e);
    return [];
  }
}

const { slug } = Astro.params;

const data = await fetchBackendJson(`/api/media/dramas/${encodeURIComponent(slug || '')}?trackView=0`, {
  revalidate: 300,
  fallback: null,
});

if (!data || !data.drama) {
  return Astro.redirect('/404');
}

const media = data.drama;
const cleanTitle = cleanMediaTitle(media.title);
const canonicalUrl = `${SITE_URL}/drama/${slug}`;
const metaTitle = buildMediaMetaTitle(media);
const rawDescription = String(media.metaDescription || '').trim();
const chosenDescription = rawDescription.length >= 60 
  ? clampDescription(rawDescription, 155) 
  : buildMediaMetaDescription(media);

const metaDescription = cleanMediaText(
  chosenDescription,
  media.title,
  cleanTitle
);
const keywords = generateMediaKeywords(media);

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Dramas', url: '/dramas' },
  { name: cleanTitle, url: `/drama/${slug}` },
]);

const dramaSchema = buildDramaSchema(media, canonicalUrl);

const faqList = Array.isArray(media.faqs) && media.faqs.length > 0 ? media.faqs : [
  {
    question: `Where can I download Sinhala subtitles for ${cleanTitle}?`,
    answer: `You can download synchronized Sinhala subtitles for all episodes of ${cleanTitle} in SRT, VTT, or ASS format directly on KSubZone.`
  },
  {
    question: `Are all episodes of ${cleanTitle} available with Sinhala subtitles?`,
    answer: `Yes, episode subtitle files are uploaded regularly by community translators as episodes air.`
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqList.map((item: any) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: cleanMediaText(item.answer, media.title, cleanTitle),
    },
  })),
};

const combinedSchema = {
  '@context': 'https://schema.org',
  '@graph': [breadcrumbs, dramaSchema, faqSchema].filter(Boolean),
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  keywords={keywords}
  canonical={canonicalUrl}
  ogImage={media.poster || `${SITE_URL}/main-logo.webp`}
  ogType="video.tv_show"
  schemaMarkup={combinedSchema}
>
  <Detail
    type="Drama"
    initialData={{
      ...data,
      drama: {
        ...media,
        title: cleanTitle,
        metaTitle,
        metaDescription,
        schemaMarkup: dramaSchema,
      },
    }}
    client:load
  />
</BaseLayout>
