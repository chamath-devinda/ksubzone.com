---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Profile } from '@/components/islands';
import { SITE_URL } from '@/lib/seo';

export const prerender = false;

const canonical = `${SITE_URL}/profile`;
const title = 'Member Profile | KSubZone';
---

<BaseLayout
  title={title}
  canonical={canonical}
  noIndex={true}
>
  <div class="pt-20 pb-16 w-full flex items-center justify-center flex-grow">
    <Profile client:load />
  </div>
</BaseLayout>
