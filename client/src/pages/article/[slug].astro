---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArticleDetail } from '@/components/islands';
import { fetchBackendJson } from '@/lib/server/backend';
import {
  SITE_URL,
  clampDescription,
  buildArticleSchema,
  buildBreadcrumbSchema,
} from '@/lib/seo';

export const prerender = true;

export async function getStaticPaths() {
  try {
    const data = await fetchBackendJson('/api/articles?status=Published&limit=200', {
      revalidate: 3600,
      fallback: { articles: [] },
    });
    const articles = data?.articles || [];
    return articles
      .filter((a: any) => a.slug || a.title)
      .map((article: any) => ({
        params: {
          slug: article.slug || article._id,
        },
      }));
  } catch (e) {
    console.error('[getStaticPaths:articles] Failed to pre-fetch article slugs:', e);
    return [];
  }
}

const { slug } = Astro.params;

const data = await fetchBackendJson(`/api/articles/${encodeURIComponent(slug || '')}?trackView=0`, {
  revalidate: 3600,
  fallback: null,
});

if (!data || !data.article) {
  return Astro.redirect('/404');
}

const article = data.article;
const canonicalUrl = `${SITE_URL}/article/${slug}`;

let rawTitle = String(article.metaTitle || `${article.title} | KSubZone Articles`).trim();
if (rawTitle.length > 65) {
  if (rawTitle.includes(' – ')) {
    const parts = rawTitle.split(' – ');
    const candidate = `${parts[0]} | KSubZone`;
    rawTitle = candidate.length <= 65 ? candidate : `${rawTitle.slice(0, 52).trim()}... | KSubZone`;
  } else if (rawTitle.includes(' | ')) {
    const parts = rawTitle.split(' | ');
    rawTitle = parts[0].length <= 53 ? `${parts[0]} | KSubZone` : `${parts[0].slice(0, 50).trim()}... | KSubZone`;
  } else {
    rawTitle = `${rawTitle.slice(0, 52).trim()}... | KSubZone`;
  }
}
const title = rawTitle;

const description = clampDescription(article.metaDescription || article.excerpt || `Read ${article.title} on KSubZone.`, 155);
const keywords = article.seoKeywords || article.tags || ['kdrama article', 'korean drama guide', 'ksubzone'];

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Articles', url: '/articles' },
  { name: article.title, url: canonicalUrl },
]);

const articleSchema = buildArticleSchema(article, canonicalUrl);

const combinedSchema = {
  '@context': 'https://schema.org',
  '@graph': [breadcrumbs, articleSchema].filter(Boolean),
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  keywords={keywords}
  ogImage={article.coverImage || `${SITE_URL}/main-logo.webp`}
  ogType="article"
  schemaMarkup={combinedSchema}
>
  <ArticleDetail
    initialData={data}
    client:load
  />
</BaseLayout>
