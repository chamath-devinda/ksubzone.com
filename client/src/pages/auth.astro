---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Auth } from '@/components/islands';
import { SITE_URL } from '@/lib/seo';

export const prerender = true;

const canonical = `${SITE_URL}/auth`;
const title = 'Sign In / Register - KSubZone Gateway';
const description = 'Access your account on KSubZone to manage your watchlist, favorites, and subtitles.';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noIndex={true}
>
  <div class="pt-20 pb-16 w-full flex items-center justify-center flex-grow">
    <Auth client:load />
  </div>
</BaseLayout>
