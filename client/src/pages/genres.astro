---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fetchBackendJson } from '@/lib/server/backend';
import { buildBreadcrumbSchema, SITE_URL } from '@/lib/seo';
import GlassCard from '@/components/ui/GlassCard.jsx';
import { Film, Tv, Sparkles, Grid } from 'lucide-react';

export const prerender = true;

const rawGenres = await fetchBackendJson('/api/media/genres', {
  revalidate: 3600,
  fallback: [],
});

const genres = Array.from(
  (Array.isArray(rawGenres) ? rawGenres : []).reduce((map: any, genre: any) => {
    if (!genre?.slug) return map;
    const current = map.get(genre.slug);
    if (!current || Number(genre.totalCount || 0) > Number(current.totalCount || 0)) {
      map.set(genre.slug, genre);
    }
    return map;
  }, new Map()).values()
).filter((genre: any) => Number(genre.totalCount || 0) > 0);

const canonical = `${SITE_URL}/genres`;
const title = 'Browse Korean Dramas & Movies by Genre | KSubZone';
const description = 'Explore Korean TV shows and movies categorized by genres. Find Action, Thriller, Comedy, Horror, Romance, and fantasy titles with Sinhala subtitles.';

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Genres', url: '/genres' },
]);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords={['k-drama genres', 'korean movies genres', 'sinhala subtitles genres', 'ksubzone']}
  schemaMarkup={breadcrumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 lg:pt-28 pb-12 w-full">
    <div class="flex items-center gap-3 mb-8">
      <div class="p-2.5 rounded-xl bg-[#9E57F6]/10 text-[#9E57F6] border border-[#9E57F6]/20">
        <Grid className="w-6 h-6" />
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold font-display text-white">
          Entertainment Genres
        </h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Explore all Korean dramas, movies, and subtitles by your favorite themes
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-5">
      {genres.map((genre: any) => (
        <a
          href={`/movies?genre=${encodeURIComponent(genre.name || genre.slug)}`}
          class="group block p-4 rounded-xl bg-[#141418] border border-white/5 hover:border-[#9E57F6]/50 hover:bg-[#181820] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_25px_rgba(158,87,246,0.15)]"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="text-base font-semibold text-white group-hover:text-[#9E57F6] transition-colors">
              {genre.name}
            </span>
            <Sparkles className="w-4 h-4 text-slate-500 group-hover:text-[#9E57F6] transition-colors" />
          </div>
          <div class="flex items-center gap-3 text-xs text-slate-400">
            {genre.movieCount > 0 && (
              <span class="flex items-center gap-1">
                <Film className="w-3 h-3 text-[#9E57F6]" />
                {genre.movieCount} Movies
              </span>
            )}
            {genre.dramaCount > 0 && (
              <span class="flex items-center gap-1">
                <Tv className="w-3 h-3 text-pink-400" />
                {genre.dramaCount} Dramas
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
