---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildBreadcrumbSchema, SITE_URL } from '@/lib/seo';
import { Info, ShieldCheck, Heart, Sparkles, Film, Users, BookOpen } from 'lucide-react';

export const prerender = true;

const canonical = `${SITE_URL}/about`;
const title = 'About Us | KSubZone - Korean Entertainment Platform';
const description = 'Learn about KSubZone, the premium catalog for Korean dramas, movies, synchronized Sinhala & English subtitles, and reviews.';

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'About Us', url: '/about' },
]);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords={['about ksubzone', 'kdrama sinhala translation team', 'ksubzone story']}
  schemaMarkup={breadcrumbs}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 lg:pt-28 pb-16 text-left flex flex-col gap-10 sm:gap-14 w-full">
    <section class="relative overflow-hidden rounded-2xl sm:rounded-3xl border border-white/5 bg-gradient-to-r from-[#9E57F6]/10 via-white/[0.02] to-pink-500/5 p-6 sm:p-12">
      <div class="relative z-10 max-w-3xl">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-[#9E57F6]/30 bg-[#9E57F6]/10 px-3.5 py-1 text-[11px] font-bold uppercase tracking-wider text-[#9E57F6]">
          <Info className="w-3.5 h-3.5" /> Our Journey
        </span>
        <h1 class="mt-5 text-3xl sm:text-5xl font-black text-white leading-tight tracking-tight font-display">
          Connecting South Asian Fans with Korean Cinema
        </h1>
        <p class="mt-4 text-sm sm:text-base text-slate-300 leading-7 font-light">
          Welcome to KSubZone, your destination for premium Korean entertainment, structured guides, and verified community-translated Sinhala and English subtitles.
        </p>
      </div>
    </section>

    <section class="grid md:grid-cols-2 gap-5 sm:gap-8">
      <div class="p-6 sm:p-8 rounded-3xl border border-white/5 bg-[#141418] flex flex-col gap-4">
        <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
          <Sparkles className="w-5 h-5 text-amber-400" /> Our Mission
        </h2>
        <p class="text-sm text-slate-300 leading-7 font-light">
          Our goal is to make Korean movies and TV shows accessible to everyone by bridging the language gap. We provide high-quality translation files, episode synopses, and detailed reviews to help local K-drama fans enjoy their favorite releases seamlessly.
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-3xl border border-white/5 bg-[#141418] flex flex-col gap-4">
        <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
          <ShieldCheck className="w-5 h-5 text-pink-400" /> Quality & Sync Timing
        </h2>
        <p class="text-sm text-slate-300 leading-7 font-light">
          We understand that a delay of even a single second can ruin a scene's impact. That is why our community-translated SRT, VTT, and ASS subtitles undergo strict timing checks and reviews by translators before being approved in our releases queue.
        </p>
      </div>
    </section>

    <section class="flex flex-col gap-8 border-t border-white/5 pt-12">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2.5">
          <Heart className="w-6 h-6 text-[#9E57F6]" /> Why KSubZone Stands Out
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Our platform is designed with features tailored specifically for K-drama lovers.</p>
      </div>

      <div class="grid sm:grid-cols-3 gap-6">
        <div class="flex flex-col gap-3 p-5 rounded-2xl bg-white/[0.015] border border-white/5">
          <div class="w-10 h-10 rounded-xl bg-[#9E57F6]/10 border border-[#9E57F6]/20 flex items-center justify-center text-[#9E57F6] mb-2">
            <Film className="w-5 h-5" />
          </div>
          <h3 class="text-sm font-bold text-white uppercase tracking-wider">Unified Catalog</h3>
          <p class="text-xs text-slate-400 leading-6 font-light">
            Explore extensive records containing ratings, directors, cast listings, and summaries populated through TMDB integration.
          </p>
        </div>

        <div class="flex flex-col gap-3 p-5 rounded-2xl bg-white/[0.015] border border-white/5">
          <div class="w-10 h-10 rounded-xl bg-pink-500/10 border border-pink-500/20 flex items-center justify-center text-pink-400 mb-2">
            <Users className="w-5 h-5" />
          </div>
          <h3 class="text-sm font-bold text-white uppercase tracking-wider">Translator Community</h3>
          <p class="text-xs text-slate-400 leading-6 font-light">
            Our site connects Sri Lankan translation enthusiasts with viewers, creating a thriving environment for crowd-sourced subtitle releases.
          </p>
        </div>

        <div class="flex flex-col gap-3 p-5 rounded-2xl bg-white/[0.015] border border-white/5">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-2">
            <BookOpen className="w-5 h-5" />
          </div>
          <h3 class="text-sm font-bold text-white uppercase tracking-wider">Guides & Analysis</h3>
          <p class="text-xs text-slate-400 leading-6 font-light">
            We publish detailed ending explanations, character-arc analysis, romance-trope retrospectives, and curated watchlists.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
