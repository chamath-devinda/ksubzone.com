---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Film } from 'lucide-react';

export const prerender = true;

const title = 'Page Not Found (404) | KSubZone';
---

<BaseLayout title={title} noIndex={true}>
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 py-20 w-full">
    <div class="w-16 h-16 rounded-2xl bg-[#9E57F6]/10 border border-[#9E57F6]/20 flex items-center justify-center text-[#9E57F6] mb-6">
      <Film className="w-8 h-8" />
    </div>
    <h1 class="text-6xl sm:text-7xl font-black text-[#9E57F6] tracking-tight font-display">404</h1>
    <h2 class="mt-4 text-2xl sm:text-3xl font-bold text-white">Page Not Found</h2>
    <p class="mt-3 text-slate-400 max-w-md text-sm sm:text-base leading-relaxed font-light">
      සොයන ලද පිටුව හමු නොවීය. ලිපිනය නිවැරදිදැයි පරීක්ෂා කරන්න හෝ මුල් පිටුව වෙත පිවිසෙන්න.
    </p>
    <a
      href="/"
      class="mt-8 px-7 py-3.5 rounded-full bg-[#9E57F6] text-white font-bold text-sm hover:bg-[#8B3CE8] transition shadow-[0_0_25px_rgba(158,87,246,0.35)]"
    >
      Back to Homepage
    </a>
  </div>
</BaseLayout>
