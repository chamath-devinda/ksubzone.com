---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Articles } from '@/components/islands';
import { fetchBackendJson } from '@/lib/server/backend';
import { buildBreadcrumbSchema, SITE_URL } from '@/lib/seo';

export const prerender = true;

const data = await fetchBackendJson('/api/articles?status=Published&limit=30', {
  revalidate: 3600,
  fallback: { articles: [] },
});
const initialData = data?.articles || [];

const canonical = `${SITE_URL}/articles`;
const title = 'KSubZone Articles | K-Drama Guides, Reviews & Notes';
const description = 'Read Korean drama articles, watch guides, character analysis, Sinhala subtitle notes, and movie recommendations on KSubZone.';

const breadcrumbs = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Articles', url: '/articles' },
]);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords={['kdrama articles', 'korean drama guides', 'sinhala subtitles', 'ksubzone articles']}
  schemaMarkup={breadcrumbs}
>
  <Articles initialData={initialData} client:load />
</BaseLayout>
